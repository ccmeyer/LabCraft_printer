{
  "schema_name": "labcraft.configuration_change_policy",
  "schema_version": 2,
  "policy_id": "labcraft-configuration-guard-v2",
  "supported_hardware_profiles": [
    "current",
    "legacy"
  ],
  "position_telemetry_max_age_ms": 2500,
  "reserved_location_names": [
    "home",
    "loading",
    "pause",
    "plate",
    "balance",
    "camera",
    "rack_position_Left",
    "rack_position_Right"
  ],
  "pair_only_location_names": [
    "rack_position_Left",
    "rack_position_Right"
  ],
  "reserved_location_prefixes": [
    "slot-"
  ],
  "always_strong_target_classes": [
    "camera",
    "reserved_location",
    "generic_location",
    "rack",
    "plate",
    "new_target"
  ],
  "warning_thresholds_steps": {},
  "rack": {
    "slot_count": 5,
    "orientation_axis": "Y",
    "orientation_direction": "increasing"
  },
  "plate": {
    "initial_orientation": "counterclockwise",
    "maximum_transform_condition_number": null
  },
  "confirmation": {
    "acknowledgement_version": 1,
    "mode": "explicit_checkbox"
  },
  "rationale": "All guarded coordinate changes remain strongly reviewed while replacing typed proposal phrases with one explicit, proposal-bound acknowledgement checkbox. Successful controlled rack and plate calibrations carry their own physical verification evidence.",
  "approval_reference": "docs/machine_data_migration_and_location_safety_plan.md"
}
